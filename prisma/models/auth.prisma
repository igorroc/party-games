model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(USER)

  sessions     Session[]
  gameSessions GameSession[]

  operationalSettingsUpdates OperationalSettings[] @relation("OperationalSettingsUpdatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String @id @default(cuid())
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

enum UserRole {
  USER
  ADMIN
}
