model Game {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String
  status      GameStatus @default(DRAFT)
  minPlayers  Int?
  maxPlayers  Int?
  durationMin Int?

  sessions GameSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GameStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}
