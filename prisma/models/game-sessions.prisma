model GameSession {
  id                      String            @id @default(cuid())
  gameId                  String
  userId                  String?
  playerCount             Int
  status                  GameSessionStatus @default(ACTIVE)
  anonymousTokenHash      String?           @unique
  anonymousTokenExpiresAt DateTime?
  lastActivityAt          DateTime          @default(now())
  startedAt               DateTime          @default(now())
  finishedAt              DateTime?

  game     Game              @relation(fields: [gameId], references: [id])
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  nemAPatoSession NemAPatoSession?
  magicalRaceSession MagicalRaceSession?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([gameId, status])
  @@index([anonymousTokenExpiresAt])
}

enum GameSessionStatus {
  ACTIVE
  FINISHED
  ABANDONED
}
