model GameSession {
  id                      String            @id @default(cuid())
  gameId                  String
  userId                  String?
  categoryId              String?
  playerCount             Int
  difficulty              QuestionDifficulty?
  status                  GameSessionStatus @default(ACTIVE)
  anonymousTokenHash      String?           @unique
  anonymousTokenExpiresAt DateTime?
  lastActivityAt          DateTime          @default(now())
  startedAt               DateTime          @default(now())
  finishedAt              DateTime?

  game     Game              @relation(fields: [gameId], references: [id])
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  category QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  rounds   GameRound[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([gameId, status])
  @@index([anonymousTokenExpiresAt])
}

model GameRound {
  id          String @id @default(cuid())
  sessionId   String
  questionId  String
  roundNumber Int
  revealedAt  DateTime?
  completedAt DateTime?

  session  GameSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question GameQuestion @relation(fields: [questionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([sessionId, roundNumber])
  @@unique([sessionId, questionId])
  @@index([sessionId])
}

enum GameSessionStatus {
  ACTIVE
  FINISHED
  ABANDONED
}
